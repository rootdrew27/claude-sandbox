{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push *:main)",
      "Bash(git push *:master)",
      "Bash(git push *--force*)",
      "Bash(git push * +*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)"
    ]
  },
  "autoCompactEnabled": true
}
